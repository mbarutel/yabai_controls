<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.asmvik.yabai_controls</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/M067036/.cargo/bin/yabai_controls</string>
        <string>daemon</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- `shell` actions run via $SHELL -c; give them Homebrew and cargo. -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/Users/M067036/.cargo/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>SHELL</key>
        <string>/bin/zsh</string>
        <key>RUST_LOG</key>
        <string>info</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <!-- Restart after a crash or a startup failure (e.g. yabai not up yet);
         stay down after `yabai_controls shutdown`. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>/tmp/yabai_controls_M067036.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/yabai_controls_M067036.err.log</string>
    <!-- Needed for the CGEventTap: the agent must run in the GUI session. -->
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
